{
  "installCommand": "npm --prefix app install --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "app/dist",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ]
}
